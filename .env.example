# Configuracao para desenvolvimento local. Nao usar em producao.

# API: porta publicada somente em 127.0.0.1
API_PORT=8000

# PostgreSQL
POSTGRES_DB=pep
POSTGRES_USER=pep
POSTGRES_PASSWORD=pep_postgres_local

# MongoDB: autenticacao no banco admin
MONGO_DB=pep
MONGO_USER=pep
MONGO_PASSWORD=pep_mongo_local

# Redis: cache sem persistencia
REDIS_PASSWORD=pep_redis_local
